+/* the visible tiled client covering (x, y), NULL if there is none */
+Client *
+clientat(Monitor *m, int x, int y)
+{
+	Client *c;
+
+	for (c = m->clients; c; c = c->next)
+		if (ISVISIBLE(c) && !c->isfloating
+		&& x >= c->x && x < c->x + WIDTH(c)
+		&& y >= c->y && y < c->y + HEIGHT(c))
+			return c;
+	return NULL;
+}
