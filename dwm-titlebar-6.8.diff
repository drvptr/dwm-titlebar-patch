+Client *
+titlebartoclient(Window w)
+{
+	Client *c;
+	Monitor *m;
+
+	if (!w)
+		return NULL;
+	for (m = mons; m; m = m->next)
+		for (c = m->clients; c; c = c->next)
+			if (c->titlebar == w)
+				return c;
+	return NULL;
+}
